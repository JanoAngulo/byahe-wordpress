{
  "color": {
    "yellow": "#FFC93C",
    "blue": "#1D3FBB",
    "navy": "#13205C",
    "red": "#D62828",
    "cream": "#FFF8E7",
    "white": "#FFFFFF"
  },
  "font": {
    "display": {
      "family": "Cubao Free",
      "fallback": "\"Space Grotesk Variable\", system-ui, sans-serif",
      "files": [
        {
          "src": "file:./assets/fonts/cubao-free-variable.woff2",
          "weight": "400",
          "stretch": "64% 177%"
        }
      ]
    },
    "heading": {
      "family": "Space Grotesk Variable",
      "fallback": "system-ui, sans-serif",
      "files": [
        {
          "src": "file:./assets/fonts/space-grotesk-latin-wght-normal.woff2",
          "weight": "300 700"
        }
      ]
    },
    "body": {
      "family": "Inter Variable",
      "fallback": "system-ui, sans-serif",
      "files": [
        {
          "src": "file:./assets/fonts/inter-latin-wght-normal.woff2",
          "weight": "100 900"
        }
      ]
    }
  },
  "typeScale": {
    "minViewport": 360,
    "maxViewport": 1280,
    "min": {
      "base": 16,
      "ratio": 1.2
    },
    "max": {
      "base": 18,
      "ratio": 1.25
    },
    "steps": {
      "sm": -1,
      "base": 0,
      "lg": 1,
      "xl": 2,
      "2xl": 3,
      "3xl": 4,
      "4xl": 5,
      "5xl": 6,
      "6xl": 7
    },
    "lineHeights": {
      "sm": 1.5,
      "base": 1.6,
      "lg": 1.5,
      "xl": 1.25,
      "2xl": 1.2,
      "3xl": 1.1,
      "4xl": 1.05,
      "5xl": 1,
      "6xl": 0.95
    }
  },
  "spacing": {
    "20": "0.5rem",
    "30": "1rem",
    "40": "1.5rem",
    "50": "2rem",
    "60": "3rem",
    "70": "4.5rem",
    "80": "6rem"
  },
  "shadow": {
    "hard-sm": "4px 4px 0 #13205C",
    "hard-md": "6px 6px 0 #13205C",
    "hard-lg": "8px 8px 0 #13205C"
  },
  "radius": {
    "sm": "6px",
    "card": "10px",
    "pill": "999px"
  },
  "shadowOffset": {
    "xs": "3px"
  },
  "duotone": {
    "navy-yellow": {
      "name": "Navy and yellow",
      "colors": [
        "navy",
        "yellow"
      ]
    }
  },
  "contrastRules": [
    {
      "fg": "navy",
      "bg": "yellow",
      "min": 4.5
    },
    {
      "fg": "white",
      "bg": "blue",
      "min": 4.5
    },
    {
      "fg": "yellow",
      "bg": "blue",
      "min": 4.5
    },
    {
      "fg": "navy",
      "bg": "white",
      "min": 4.5
    },
    {
      "fg": "navy",
      "bg": "cream",
      "min": 4.5
    },
    {
      "fg": "red",
      "bg": "white",
      "min": 4.5
    },
    {
      "fg": "red",
      "bg": "yellow",
      "min": 3,
      "note": "large text only"
    },
    {
      "fg": "white",
      "bg": "red",
      "min": 4.5
    },
    {
      "fg": "yellow",
      "bg": "navy",
      "min": 4.5
    },
    {
      "fg": "white",
      "bg": "navy",
      "min": 4.5
    },
    {
      "fg": "cream",
      "bg": "navy",
      "min": 4.5
    }
  ]
}
