{
  "color": {
    "yellow": "#FFC93C",
    "blue": "#1D3FBB",
    "navy": "#13205C",
    "red": "#D62828",
    "cream": "#FFF8E7",
    "white": "#FFFFFF"
  },
  "font": {
    "heading": { "family": "Space Grotesk Variable", "fallback": "system-ui, sans-serif" },
    "body": { "family": "Inter Variable", "fallback": "system-ui, sans-serif" }
  },
  "fontSize": {
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem",
    "xl": "1.375rem",
    "2xl": "1.75rem",
    "3xl": "2.25rem",
    "4xl": "3rem",
    "5xl": "4rem"
  },
  "spacing": {
    "20": "0.5rem",
    "30": "1rem",
    "40": "1.5rem",
    "50": "2rem",
    "60": "3rem",
    "70": "4.5rem",
    "80": "6rem"
  },
  "shadow": {
    "hard-sm": "4px 4px 0 #13205C",
    "hard-lg": "8px 8px 0 #13205C"
  },
  "radius": {
    "card": "10px",
    "pill": "999px"
  },
  "contrastRules": [
    { "fg": "navy", "bg": "yellow", "min": 4.5 },
    { "fg": "white", "bg": "blue", "min": 4.5 },
    { "fg": "yellow", "bg": "blue", "min": 4.5 },
    { "fg": "navy", "bg": "white", "min": 4.5 },
    { "fg": "navy", "bg": "cream", "min": 4.5 },
    { "fg": "red", "bg": "white", "min": 4.5 },
    { "fg": "red", "bg": "yellow", "min": 3, "note": "large text only" }
  ]
}
