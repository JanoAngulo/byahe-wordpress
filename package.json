{
  "name": "byahe",
  "private": true,
  "type": "module",
  "description": "BYAHE: fictional Philippine fintech marketing site, HTML + Tailwind prototype converted to a WordPress block theme.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "test:unit": "node --test tests/unit/",
    "build:tokens": "node scripts/build-tokens.mjs",
    "dev:proto": "vite --config prototype/vite.config.mjs",
    "build:proto": "npm run build:tokens && vite build --config prototype/vite.config.mjs",
    "preview:proto": "vite preview --config prototype/vite.config.mjs --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "dev:wp": "wp-playground-cli server --port=9400 --php=8.2 --login --mount-dir ./theme/byahe /wordpress/wp-content/themes/byahe --mount-dir ./plugins/byahe-core /wordpress/wp-content/plugins/byahe-core --blueprint=./blueprint.local.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@wp-playground/cli": "3.1.64",
    "lucide-static": "^1.72.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wawoff2": "^2.0.1"
  }
}
