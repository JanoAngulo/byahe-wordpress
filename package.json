{
  "name": "byahe",
  "private": true,
  "type": "module",
  "description": "BYAHE: fictional Philippine fintech marketing site, HTML + Tailwind prototype converted to a WordPress block theme.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "test:unit": "node --test tests/unit/",
    "build:tokens": "node scripts/build-tokens.mjs",
    "dev:proto": "vite --config prototype/vite.config.mjs",
    "build:proto": "npm run build:tokens && vite build --config prototype/vite.config.mjs",
    "preview:proto": "vite preview --config prototype/vite.config.mjs --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "dev:wp": "npm run build:wp && wp-playground-cli server --port=9400 --php=8.2 --login --mount-dir ./theme/byahe /wordpress/wp-content/themes/byahe --mount-dir ./plugins/byahe-core /wordpress/wp-content/plugins/byahe-core --blueprint=./blueprint.local.json",
    "build:assets": "node scripts/copy-assets.mjs",
    "build:css": "tailwindcss -i theme/byahe/src/theme.css -o theme/byahe/assets/css/theme.css --minify",
    "build:blocks": "wp-scripts build --webpack-src-dir=plugins/byahe-core/src --output-path=plugins/byahe-core/build --experimental-modules --blocks-manifest",
    "build:wp": "npm run build:tokens && npm run build:assets && npm run build:css && npm run build:blocks",
    "serve:wp": "wp-playground-cli server --port=9410 --php=8.2 --mount-dir ./theme/byahe /wordpress/wp-content/themes/byahe --mount-dir ./plugins/byahe-core /wordpress/wp-content/plugins/byahe-core --blueprint=./blueprint.local.json",
    "test:wp": "playwright test -c playwright.wp.config.mjs",
    "lint:php": "composer exec phpcs",
    "lint:js": "wp-scripts lint-js plugins/byahe-core/src",
    "lint:css": "wp-scripts lint-style \"theme/byahe/src/**/*.css\" \"plugins/byahe-core/src/**/*.css\" --allow-empty-input",
    "lint": "npm run lint:php && npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@wordpress/scripts": "^37.1.0",
    "@wp-playground/cli": "3.1.64",
    "lucide-static": "^1.72.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wawoff2": "^2.0.1"
  }
}
