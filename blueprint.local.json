{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEVELOPMENT_MODE": "all"
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "byahe"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "byahe-core/byahe-core.php"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "BYAHE",
        "blogdescription": "Bayad na, tuloy ang byahe."
      }
    },
    {
      "step": "wp-cli",
      "command": "wp byahe seed"
    }
  ]
}
